rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /acessos/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['usuario', 'cliente', 'telefone', 'valor', 'app', 'vencimento', 'data', 'userId']);
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /despesas/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['descricao', 'valor', 'data', 'userId']);
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /configuracoes/{document} {
      allow read, write: if request.auth != null && request.auth.uid == document;
    }
    match /pagamentos/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /usuarios/{document} {
      allow read: if request.auth != null && (request.auth.uid == document || request.auth.token.email == 'elison28araujo@gmail.com');
      allow create: if request.auth != null && (
        request.auth.token.email == 'elison28araujo@gmail.com'
        || (
          request.auth.uid == document
          && request.resource.data.status == 'pending'
          && (!('vencimentoLicenca' in request.resource.data) || request.resource.data.vencimentoLicenca == '')
        )
      );
      allow update: if request.auth != null && (
        request.auth.token.email == 'elison28araujo@gmail.com'
        || (
          request.auth.uid == document
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'vencimentoLicenca', 'email', 'uid'])
        )
      );
      allow delete: if request.auth != null && request.auth.token.email == 'elison28araujo@gmail.com';
    }
    match /suporte_conversas/{conversaId} {
      allow read, write: if request.auth != null && (request.auth.uid == conversaId || request.auth.token.email == 'elison28araujo@gmail.com');
      match /mensagens/{mensagemId} {
        allow read, write: if request.auth != null && (request.auth.uid == conversaId || request.auth.token.email == 'elison28araujo@gmail.com');
      }
    }
    match /pagamentos_pendentes/{document} {
      allow read, write: if false;
    }
    match /suporte_push_tokens/{document} {
      allow read, write: if false;
    }
    match /notificacoes_enviadas/{document} {
      allow read, write: if false;
    }
  }
}
