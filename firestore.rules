rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /acessos/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['usuario', 'cliente', 'telefone', 'valor', 'app', 'vencimento', 'data', 'userId']);
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /despesas/{document} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['descricao', 'valor', 'data', 'userId']);
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /configuracoes/{document} {
      allow read, write: if request.auth != null && request.auth.uid == document;
    }
    match /pagamentos/{document} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /usuarios/{document} {
      allow read, write: if request.auth != null && (request.auth.uid == document || request.auth.token.email == 'elison28araujo@gmail.com');
    }
  }
}
